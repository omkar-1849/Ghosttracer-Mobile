# ==============================================================================
# Sentinel Mobile - Environment Configuration Template
# Copy this file to .env and adjust the variables to match your environment.
# DO NOT commit .env with real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sentinel Backend Configuration
# ------------------------------------------------------------------------------
# Default backend URL accessible by the mobile application:
# - Android Emulator loopback: http://10.0.2.2:8000/
# - Physical USB Device (with 'adb reverse tcp:8000 tcp:8000'): http://127.0.0.1:8000/
# - Local Network / WiFi: http://192.168.1.X:8000/
# - Production Host: https://sentinel-api.example.com/
SENTINEL_BASE_URL=http://127.0.0.1:8000/

# Absolute or relative path to the core Sentinel backend repository (used by e2e test suite)
SENTINEL_BACKEND_PATH=../backend

# ------------------------------------------------------------------------------
# 2. Telemetry Ingestion & Forwarding (e.g. Zerodha Lab)
# ------------------------------------------------------------------------------
# Monitored web application endpoint
ZERODHA_URL=http://127.0.0.1:8080

# Sentinel core ingestion endpoint
SENTINEL_URL=http://127.0.0.1:8000

# Sentinel Ingestion Collector API Key (obtained from Sentinel Core Integrations)
SENTINEL_API_KEY=your_sentinel_collector_api_key_here

# Path to the application security log file
ZERODHA_LOG_PATH=logs/security.log

# Tenant & Asset IDs
ORGANIZATION_ID=18
WEBSITE_ID=19

# ------------------------------------------------------------------------------
# 3. Test Credentials (Local Development & CI Only)
# ------------------------------------------------------------------------------
TEST_USER_EMAIL=soc_analyst@sentinel.ai
TEST_USER_PASSWORD=ChangeMeInProduction!
